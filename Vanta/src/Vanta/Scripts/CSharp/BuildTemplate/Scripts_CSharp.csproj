<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Disable generating runtime config files that your engine doesn't use -->
        <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <!-- 1. Define fallback path logic properly -->
        <CoreLibDir Condition="'$(VantaScriptCoreDir)' == ''">lib/</CoreLibDir>
        <CoreLibDir Condition="'$(VantaScriptCoreDir)' != ''">$(VantaScriptCoreDir)</CoreLibDir>

        <!-- 2. Clean trailing slashes to keep HintPath safe -->
        <CoreLibDir>$([MSBuild]::EnsureTrailingSlash('$(CoreLibDir)'))</CoreLibDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- 3. Consume the evaluated property path here -->
        <Reference Include="Vanta-ScriptCore-CSharp">
            <HintPath>$(CoreLibDir)Vanta-ScriptCore-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

</Project>
)="
